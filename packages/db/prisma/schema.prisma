// =============================================================
// 服装电商双平台运营系统 · Prisma 物理模型（M1）
//
// 依据：docs/06-领域模型与数据字典.md（表/列基础）+ docs/21-接口契约裁决.md
//   （docs/21 为冲突唯一权威：金额 *_cents 整数分、uuid v7 主键、workflow_run.state /
//    listing.status 词表、model_route 作用域与配额列、provider.credential_ref 无外键、
//    media_quota 表）。共 30 张 docs/06 表 + 1 张 docs/21 新增表 = 31 张。
//
// 分工（重要）：
//   - 本文件只映射「表 + 列 + 类型 + 默认值」，保证 Prisma Client 可用；
//   - 枚举用 text（§0.5），不用 PostgreSQL 原生 ENUM；
//   - 所有 CHECK、复合/部分唯一索引、外键、触发器、函数、HNSW/GIN 索引、
//     `vector` 扩展、种子数据，都在迁移 SQL 中显式创建
//     （见 prisma/migrations/20261020142000_init/migration.sql）；
//   - 不在本文件声明 relation / @@index / @@unique：docs/06 的唯一性与索引
//     大量是部分索引（WHERE archived_at IS NULL），Prisma 无法表达，
//     声明后会在迁移里生成全量唯一索引，与 docs/06 冲突。
//
// Prisma 能力边界（已在 docs/验收记录-M1-骨架.md 登记为差异项）：
//   - users.email 的 citext：Prisma 6.19.3 不支持 @db.Citext，
//     落库为 text + `lower(email)` 唯一索引（语义等价：大小写不敏感唯一）；
//   - audit_log.ip 的 inet：Prisma 不支持 @db.Inet，落库为 text + inet 格式 CHECK；
//   - kb_chunk.embedding 用 Unsupported("vector(1024)")，读写必须走 $queryRaw；
//   - kb_chunk.tsv 用 Unsupported("tsvector")，由应用侧分词后写入。
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// 0. 公共字段（docs/06 §0.6）
//   id uuid PK (gen_random_uuid) / org_id bigint default 1 /
//   created_at / updated_at / created_by / version default 1 / archived_at
// 例外见各表注释（§0.7）。
// -------------------------------------------------------------

// =============================================================
// 4.8 治理
// =============================================================

/// users — 账号（docs/06 §4.8.1）。email 登录名，citext → text + lower(email) 唯一。
model User {
  id             String    @id @default(uuid(7)) @db.Uuid
  orgId          BigInt    @default(1) @map("org_id")
  email          String
  displayName    String    @map("display_name")
  passwordHash   String    @map("password_hash")
  totpSecretRef  String?   @map("totp_secret_ref")
  totpEnabled    Boolean   @default(false) @map("totp_enabled")
  status         String    @default("active")
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz
  failedAttempts Int       @default(0) @map("failed_attempts") @db.SmallInt
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz
  locale         String    @default("zh-CN")
  timezone       String    @default("Asia/Shanghai")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdBy      String?   @map("created_by") @db.Uuid
  version        Int       @default(1)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz

  @@map("users")
}

/// roles — 角色（docs/06 §4.8.2）。viewer / operator / admin，种子数据由迁移写入。
model Role {
  id          String    @id @default(uuid(7)) @db.Uuid
  orgId       BigInt    @default(1) @map("org_id")
  code        String
  name        String
  permissions String[]  @default([])
  isSystem    Boolean   @default(true) @map("is_system")
  description String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdBy   String?   @map("created_by") @db.Uuid
  version     Int       @default(1)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz

  @@map("roles")
}

/// memberships — 授权关系（docs/06 §4.8.3）。无 created_by，用 granted_by。
model Membership {
  id         String    @id @default(uuid(7)) @db.Uuid
  orgId      BigInt    @default(1) @map("org_id")
  userId     String    @map("user_id") @db.Uuid
  roleId     String    @map("role_id") @db.Uuid
  status     String    @default("active")
  grantedBy  String?   @map("granted_by") @db.Uuid
  grantedAt  DateTime  @default(now()) @map("granted_at") @db.Timestamptz
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  version    Int       @default(1)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz

  @@map("memberships")
}

/// audit_log — 审计（docs/06 §4.8.4 + docs/21 §10）。id uuid v7 主键，seq 单调序列；
/// 只插入不更新（迁移建 trg_audit_no_update）。
model AuditLog {
  id           String   @id @default(uuid(7)) @db.Uuid
  seq          BigInt   @unique @default(autoincrement())
  orgId        BigInt   @default(1) @map("org_id")
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz
  actorType    String   @map("actor_type")
  actorId      String?  @map("actor_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id") @db.Uuid
  requestId    String   @map("request_id")
  before       Json     @default("{}")
  after        Json     @default("{}")
  diff         Json     @default("{}")
  irreversible Boolean  @default(false)
  ip           String?
  userAgent    String?  @map("user_agent")
  chainPrev    String?  @map("chain_prev")
  chainHash    String   @map("chain_hash")
  meta         Json     @default("{}")

  @@map("audit_log")
}

// =============================================================
// 4.1 供应商与模型
// =============================================================

/// credential_ref — 凭据元数据（docs/21 §9）。只存名称/用途/轮换信息，真值在 DSH 凭据存储。
model CredentialRef {
  id            String    @id @default(uuid(7)) @db.Uuid
  orgId         BigInt    @default(1) @map("org_id")
  name          String
  purpose       String    @default("provider")
  status        String    @default("active")
  lastRotatedAt DateTime? @map("last_rotated_at") @db.Timestamptz
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdBy              String?   @map("created_by") @db.Uuid
  version                Int       @default(1)
  archivedAt             DateTime? @map("archived_at") @db.Timestamptz

  @@map("credential_ref")
}

/// provider — 供应商账号（docs/06 §4.1.1 + docs/21 §9）。credential_ref 为 DSH 凭据名，不建外键。
model Provider {
  id                 String    @id @default(uuid(7)) @db.Uuid
  orgId              BigInt    @default(1) @map("org_id")
  name               String
  kind               String
  vendor             String    @default("other")
  baseUrl            String?   @map("base_url")
  credentialRef      String    @map("credential_ref")
  authScheme         String    @default("bearer") @map("auth_scheme")
  timeoutMs          Int       @default(60000) @map("timeout_ms")
  maxConcurrency     Int       @default(8) @map("max_concurrency") @db.SmallInt
  rateLimit          Json      @default("{}") @map("rate_limit")
  status             String    @default("configuring")
  connectivity       String    @default("unknown")
  lastCheckAt        DateTime? @map("last_check_at") @db.Timestamptz
  lastCheckLatencyMs Int?      @map("last_check_latency_ms")
  lastErrorCode      String?   @map("last_error_code")
  balanceCents       Int?      @map("balance_cents")
  balanceCheckedAt   DateTime? @map("balance_checked_at") @db.Timestamptz
  region             String?
  extra              Json      @default("{}")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdBy          String?   @map("created_by") @db.Uuid
  version            Int       @default(1)
  archivedAt         DateTime? @map("archived_at") @db.Timestamptz

  @@map("provider")
}

/// model — 模型与参数价格（docs/21 §1）。price 为 jsonb 计价单：
/// { text:{input_per_1k_cents,output_per_1k_cents}, image:{per_image_cents,per_megapixel_cents},
///   video:{per_second_cents}, embed:{per_1k_tokens_cents} }
model Model {
  id              String    @id @default(uuid(7)) @db.Uuid
  orgId           BigInt    @default(1) @map("org_id")
  providerId      String    @map("provider_id") @db.Uuid
  name            String
  externalModelId String    @map("external_model_id")
  displayName     String    @map("display_name")
  capability      String
  purposeSupport  String[]  @default([]) @map("purpose_support")
  paramsSchema    Json      @map("params_schema")
  defaultParams   Json      @default("{}") @map("default_params")
  price           Json
  priceVersion    Int       @default(1) @map("price_version")
  rateLimit       Json      @default("{}") @map("rate_limit")
  contextTokens   Int?      @map("context_tokens")
  maxOutputTokens Int?      @map("max_output_tokens")
  embedDim        Int?      @map("embed_dim") @db.SmallInt
  status          String    @default("draft")
  publishedAt     DateTime? @map("published_at") @db.Timestamptz
  publishedBy     String?   @map("published_by") @db.Uuid
  deprecatedAt    DateTime? @map("deprecated_at") @db.Timestamptz
  sunsetAt        DateTime? @map("sunset_at") @db.Timestamptz
  docsUrl         String?   @map("docs_url")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdBy       String?   @map("created_by") @db.Uuid
  version         Int       @default(1)
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz

  @@map("model")
}

/// model_route — 用途路由与降级链（docs/06 §4.1.3 + docs/21 §5/§8）。作用域拆列；配额用显式列。
model ModelRoute {
  id            String    @id @default(uuid(7)) @db.Uuid
  orgId         BigInt    @default(1) @map("org_id")
  scopeType     String    @default("org") @map("scope_type")
  scopeRoleId   String?   @map("scope_role_id") @db.Uuid
  scopeUserId   String?   @map("scope_user_id") @db.Uuid
  purpose       String
  modelId       String    @map("model_id") @db.Uuid
  fallbackIds   String[]  @default([]) @map("fallback_ids") @db.Uuid
  priority      Int       @default(100)
  rpm              Int?
  tpm              Int?
  concurrency      Int?
  dailyCalls       Int?      @map("daily_calls")
  dailyCostCents   Int?      @map("daily_cost_cents")
  monthlyCostCents Int?      @map("monthly_cost_cents")
  status        String    @default("draft")
  effectiveFrom DateTime? @map("effective_from") @db.Timestamptz
  effectiveTo   DateTime? @map("effective_to") @db.Timestamptz
  label         String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdBy     String?   @map("created_by") @db.Uuid
  version       Int       @default(1)
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz

  @@map("model_route")
}

/// model_call_log — 调用流水（docs/06 §4.1.5 + docs/21 §1）。price_snapshot 为调用时价目快照。
model ModelCallLog {
  id                  String    @id @default(uuid(7)) @db.Uuid
  orgId               BigInt    @default(1) @map("org_id")
  requestId           String    @map("request_id")
  purpose             String
  providerId          String    @map("provider_id") @db.Uuid
  modelId             String    @map("model_id") @db.Uuid
  routeId             String?   @map("route_id") @db.Uuid
  fallbackFromModelId String?   @map("fallback_from_model_id") @db.Uuid
  actorType           String    @map("actor_type")
  actorId             String?   @map("actor_id") @db.Uuid
  subjectType         String    @default("other") @map("subject_type")
  subjectId           String?   @map("subject_id") @db.Uuid
  promptVersion       String?   @map("prompt_version")
  inputTokens         Int       @default(0) @map("input_tokens")
  outputTokens        Int       @default(0) @map("output_tokens")
  cachedInputTokens   Int       @default(0) @map("cached_input_tokens")
  imageCount          Int       @default(0) @map("image_count")
  imagePixels         BigInt?   @map("image_pixels")
  videoSeconds        Decimal   @default(0) @map("video_seconds") @db.Decimal(10, 3)
  latencyMs           Int       @default(0) @map("latency_ms")
  status              String
  errorCode           String?   @map("error_code")
  tokensSource        String    @default("provider_usage") @map("tokens_source")
  costCents           Int       @default(0) @map("cost_cents")
  priceSnapshot       Json      @default("{}") @map("price_snapshot")
  startedAt           DateTime  @default(now()) @map("started_at") @db.Timestamptz
  finishedAt          DateTime? @map("finished_at") @db.Timestamptz
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy           String?   @map("created_by") @db.Uuid

  @@map("model_call_log")
}

// =============================================================
// 4.2 商品
// =============================================================

/// platform_category — 平台类目字典（docs/06 §4.2.5）。
model PlatformCategory {
  id                        String    @id @default(uuid(7)) @db.Uuid
  orgId                     BigInt    @default(1) @map("org_id")
  platform                  String
  externalCategoryId        String    @map("external_category_id")
  name                      String
  path                      String[]  @default([])
  level                     Int       @default(1) @db.SmallInt
  parentExternalId          String?   @map("parent_external_id")
  isLeaf                    Boolean   @default(true) @map("is_leaf")
  requiredAttrs             Json      @default("[]") @map("required_attrs")
  qualificationRequirements Json      @default("[]") @map("qualification_requirements")
  feeRules                  Json      @default("{}") @map("fee_rules")
  status                    String    @default("active")
  fetchedAt                 DateTime  @default(now()) @map("fetched_at") @db.Timestamptz
  contractVersion           String?   @map("contract_version")
  raw                       Json?
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdBy                 String?   @map("created_by") @db.Uuid
  version                   Int       @default(1)
  archivedAt                DateTime? @map("archived_at") @db.Timestamptz

  @@map("platform_category")
}

/// product — SPU 主数据（docs/06 §4.2.1 + docs/21 §6）。内部类目用 category_code，平台类目走 platform_category。
model Product {
  id               String    @id @default(uuid(7)) @db.Uuid
  orgId            BigInt    @default(1) @map("org_id")
  spuCode          String    @map("spu_code")
  name             String
  brand            String?
  season           String    @default("all")
  year             Int?      @db.SmallInt
  fit              String?
  styleTags        String[]  @default([]) @map("style_tags")
  categoryCode     String    @map("category_code")
  status           String    @default("draft")
  qualification    Json      @default("{}")
  careInstructions Json      @default("{}") @map("care_instructions")
  originCountry    String?   @map("origin_country") @db.Char(2)
  launchDate       DateTime? @map("launch_date") @db.Date
  mainAssetId      String?   @map("main_asset_id") @db.Uuid
  attributes       Json      @default("{}")
  factVersion      Int       @default(1) @map("fact_version")
  dataSource       String    @default("import") @map("data_source")
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdBy        String?   @map("created_by") @db.Uuid
  version          Int       @default(1)
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz

  @@map("product")
}

/// product_sku — SKU 主数据（docs/06 §4.2.2）。价格/库存/成分/尺码为硬事实。
model ProductSku {
  id                 String    @id @default(uuid(7)) @db.Uuid
  orgId              BigInt    @default(1) @map("org_id")
  skuCode            String    @map("sku_code")
  productId          String    @map("product_id") @db.Uuid
  colorId            String    @map("color_id")
  colorName          String    @map("color_name")
  sizeCode           String    @map("size_code")
  fabricCode         String    @map("fabric_code")
  barcode            String?
  priceCents         Int       @map("price_cents")
  listPriceCents     Int?      @map("list_price_cents")
  salePriceCents     Int?      @map("sale_price_cents")
  priceTiers         Json      @default("[]") @map("price_tiers")
  priceSource        String    @default("import") @map("price_source")
  costCents          Int?      @map("cost_cents")
  stockQty           Int       @default(0) @map("stock_qty")
  safetyStock        Int       @default(0) @map("safety_stock")
  stockSource        String    @default("import") @map("stock_source")
  minOrderQty        Int       @default(1) @map("min_order_qty")
  leadTimeDays       Int?      @map("lead_time_days") @db.SmallInt
  weightG            Int?      @map("weight_g")
  status             String    @default("active")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdBy          String?   @map("created_by") @db.Uuid
  version            Int       @default(1)
  archivedAt         DateTime? @map("archived_at") @db.Timestamptz

  @@map("product_sku")
}

/// size_chart — 尺码表（docs/06 §4.2.3 + docs/21 §6）。一尺码一行（sku_size_code），version_no + effective_from(timestamptz)。
model SizeChart {
  id                 String    @id @default(uuid(7)) @db.Uuid
  orgId              BigInt    @default(1) @map("org_id")
  productId          String    @map("product_id") @db.Uuid
  versionNo          Int       @default(1) @map("version_no")
  status             String    @default("draft")
  sizeSystem         String    @default("alpha") @map("size_system")
  skuSizeCode        String    @map("sku_size_code")
  sizeOrder          Int       @default(0) @map("size_order") @db.SmallInt
  measurements       Json
  recommendHeightMin Int?      @map("recommend_height_min") @db.SmallInt
  recommendHeightMax Int?      @map("recommend_height_max") @db.SmallInt
  recommendWeightMin Int?      @map("recommend_weight_min") @db.SmallInt
  recommendWeightMax Int?      @map("recommend_weight_max") @db.SmallInt
  fitNote            String?   @map("fit_note")
  source             String    @default("manual")
  effectiveFrom      DateTime  @map("effective_from") @db.Timestamptz
  effectiveTo        DateTime? @map("effective_to") @db.Timestamptz
  checksum           String
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdBy          String?   @map("created_by") @db.Uuid
  version            Int       @default(1)
  archivedAt         DateTime? @map("archived_at") @db.Timestamptz

  @@map("size_chart")
}

/// fabric_composition — 面料成分（docs/06 §4.2.4）。一「面料」一行，materials 数组合计 100。
model FabricComposition {
  id            String    @id @default(uuid(7)) @db.Uuid
  orgId         BigInt    @default(1) @map("org_id")
  productId     String    @map("product_id") @db.Uuid
  versionNo     Int       @default(1) @map("version_no")
  fabricCode    String    @map("fabric_code")
  fabricName    String    @map("fabric_name")
  role          String    @default("main")
  materials     Json
  status        String    @default("draft")
  source        String    @default("manual")
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  checksum      String
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdBy     String?   @map("created_by") @db.Uuid
  version       Int       @default(1)
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz

  @@map("fabric_composition")
}

/// platform_attribute_mapping — 内部值与平台属性值映射（docs/06 §4.2.6）。
model PlatformAttributeMapping {
  id                 String    @id @default(uuid(7)) @db.Uuid
  orgId              BigInt    @default(1) @map("org_id")
  platform           String
  platformCategoryId String    @map("platform_category_id") @db.Uuid
  productId          String?   @map("product_id") @db.Uuid
  skuId              String?   @map("sku_id") @db.Uuid
  attrPath           String    @map("attr_path")
  attrType           String    @default("enum") @map("attr_type")
  internalField      String    @map("internal_field")
  internalValue      String    @map("internal_value")
  platformValueId    String?   @map("platform_value_id")
  platformValueName  String?   @map("platform_value_name")
  extra              Json      @default("{}")
  status             String    @default("draft")
  source             String    @default("manual")
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz
  verifiedBy         String?   @map("verified_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdBy          String?   @map("created_by") @db.Uuid
  version            Int       @default(1)
  archivedAt         DateTime? @map("archived_at") @db.Timestamptz

  @@map("platform_attribute_mapping")
}

// =============================================================
// 4.3 内容
// =============================================================

/// content_draft — 文案草稿（docs/21 §7）。content_type：title|selling_points|detail|faq|reply|quote；facts 为 FactEnvelopeV1。
model ContentDraft {
  id            String    @id @default(uuid(7)) @db.Uuid
  orgId         BigInt    @default(1) @map("org_id")
  productId     String    @map("product_id") @db.Uuid
  skuId         String?   @map("sku_id") @db.Uuid
  platform      String
  contentType   String    @map("content_type")
  title         String?
  body          String
