/// listing_snapshot — 上架快照（docs/12 §9.2）。snapshot_hash 唯一，用于写前/写后对账。
model ListingSnapshot {
  id           String    @id @default(uuid(7)) @db.Uuid
  orgId        BigInt    @default(1) @map("org_id")
  listingId    String    @map("listing_id") @db.Uuid
  snapshotHash String    @map("snapshot_hash")
  capturedAt   DateTime  @default(now()) @map("captured_at") @db.Timestamptz
  source       String    @default("pre_write")
  fields       Json      @default("{}")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdBy    String?   @map("created_by") @db.Uuid
  version      Int       @default(1)
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz

  @@map("listing_snapshot")
}

/// listing_write_log — 写入门留痕（docs/12 §9.2，P0）。禁止伪回滚的物理依据。
model ListingWriteLog {
  id                   String    @id @default(uuid(7)) @db.Uuid
  orgId                BigInt    @default(1) @map("org_id")
  listingId            String    @map("listing_id") @db.Uuid
  approvalId           String?   @map("approval_id") @db.Uuid
  workflowRunId        String?   @map("workflow_run_id") @db.Uuid
  level                String
  action               String
  payloadHash          String    @map("payload_hash")
  idempotencyKey       String    @map("idempotency_key")
  restoredFromSnapshot Boolean   @default(false) @map("restored_from_snapshot")
  platformResponse     Json      @default("{}") @map("platform_response")
  occurredAt           DateTime  @default(now()) @map("occurred_at") @db.Timestamptz
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdBy            String?   @map("created_by") @db.Uuid
  version              Int       @default(1)
  archivedAt           DateTime? @map("archived_at") @db.Timestamptz

  @@map("listing_write_log")
}

/// reply_draft — 客服回复草稿（docs/12 §9.2）。degraded=true 表示走降级模板。
model ReplyDraft {
  id         String    @id @default(uuid(7)) @db.Uuid
  orgId      BigInt    @default(1) @map("org_id")
  messageId  String    @map("message_id") @db.Uuid
  conversationId String? @map("conversation_id") @db.Uuid
  draftText  String    @map("draft_text")
  degraded   Boolean   @default(false)
  evidenceRefs Json    @default("[]") @map("evidence_refs")
  fallbackReason String? @map("fallback_reason")
  modelCallId String?  @map("model_call_id") @db.Uuid
  latencyMs  Int?      @map("latency_ms")
  templateId String?   @map("template_id") @db.Uuid
  status     String    @default("draft")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdBy  String?   @map("created_by") @db.Uuid
  version    Int       @default(1)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz

  @@map("reply_draft")
}

/// reply_template — 话术模板（docs/12 §9.2）。weight 用于同 intent 多模板选择。
model ReplyTemplate {
  id         String    @id @default(uuid(7)) @db.Uuid
  orgId      BigInt    @default(1) @map("org_id")
  platform   String
  intent     String
  name       String?
  category   String?
  priority   Int       @default(0)
  usageCount Int       @default(0) @map("usage_count")
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz
  approvedAt DateTime? @map("approved_at") @db.Timestamptz
  effectiveFrom DateTime? @map("effective_from") @db.Timestamptz
  effectiveTo DateTime? @map("effective_to") @db.Timestamptz
  content    String
  status     String    @default("draft")
  weight     Int       @default(100)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdBy  String?   @map("created_by") @db.Uuid
  version    Int       @default(1)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz

  @@map("reply_template")
}

/// event_log — SSE 事件重放日志（docs/18；保留 7 天，应用清理）。seq 为全局单调游标。
model EventLog {
  seq       BigInt   @id @default(autoincrement()) @db.BigInt
  userId    String?  @map("user_id") @db.Uuid
  topic     String
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("event_log")
}

/// idempotency_key — 写操作幂等键（docs/11 §5.3；docs/12 §9.2）。
model IdempotencyKey {
  id               String    @id @default(uuid(7)) @db.Uuid
