  embedding        Unsupported("vector(1024)")?
  embeddingModelId String?                     @map("embedding_model_id") @db.Uuid
  embeddingDim     Int?                        @map("embedding_dim") @db.SmallInt
  tsv              Unsupported("tsvector")?
  metadata         Json                        @default("{}")
  aclRoles         String[]                    @map("acl_roles")
  effectiveFrom    DateTime                    @map("effective_from") @db.Timestamptz
  effectiveTo      DateTime?                   @map("effective_to") @db.Timestamptz
  status           String                      @default("active")
  supersededBy     String?                     @map("superseded_by") @db.Uuid
  createdAt        DateTime                    @default(now()) @map("created_at") @db.Timestamptz
  archivedAt       DateTime?                   @map("archived_at") @db.Timestamptz

  @@map("kb_chunk")
}

/// kb_query_log — 检索留痕（docs/06 §4.9.3）。无 version/updated_at/archived_at。
model KbQueryLog {
  id                 String   @id @default(uuid(7)) @db.Uuid
  orgId              BigInt   @default(1) @map("org_id")
  requestId          String   @map("request_id")
  actorId            String?  @map("actor_id") @db.Uuid
  roleCode           String   @map("role_code")
  purpose            String   @default("retrieval")
  query              String
  mode               String   @default("hybrid")
  topK               Int      @default(8) @map("top_k") @db.SmallInt
  filters            Json     @default("{}")
  hitCount           Int      @default(0) @map("hit_count")
  hits               Json     @default("[]")
  citations          Json     @default("[]")
  degraded           Boolean  @default(false)
  degradeReason      String?  @map("degrade_reason")
  latencyMs          Int      @default(0) @map("latency_ms")
  rerankUsed         Boolean  @default(false) @map("rerank_used")
  rerankCostCents    Int      @default(0) @map("rerank_cost_cents")
  feedback           String   @default("none")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy          String?  @map("created_by") @db.Uuid

  @@map("kb_query_log")
}

// =============================================================
// 4.10 支撑表（docs/12 §9.2；docs/21 §17-6）
// 公共字段按 docs/06 §0.6 补齐；金额列一律 int4（docs/21 §17-4）。
