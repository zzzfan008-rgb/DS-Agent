{
  "schemaVersion": 1,
  "preset": "clothing-ops",
  "bundleVersion": "1.0.0",
  "dsh": ">=0.2.1-rc.2 <0.3.0",
  "skillCatalog": [
    { "name": "brand-tone", "version": "2.1.0" },
    { "name": "size-guide", "version": "3.0.1" },
    { "name": "care", "version": "1.1.0" },
    { "name": "return-policy", "version": "1.3.0" }
  ],
  "intents": {
    "content.draft": {
      "bundle": "1.0.0",
      "skills": ["brand-tone@2.1.0"],
      "modelRoute": "copy-default"
    },
    "content.rewrite": {
      "bundle": "1.0.0",
      "skills": ["brand-tone@2.1.0"],
      "modelRoute": "copy-default"
    },
    "product.qa": {
      "bundle": "1.0.0",
      "skills": ["size-guide@3.0.1", "care@1.1.0"],
      "modelRoute": "qa-default"
    },
    "support.suggest": {
      "bundle": "1.0.0",
      "skills": ["return-policy@1.3.0", "brand-tone@2.1.0"],
      "modelRoute": "reply-default"
    },
    "inquiry.quote_draft": {
      "bundle": "1.0.0",
      "skills": ["brand-tone@2.1.0", "size-guide@3.0.1"],
      "modelRoute": "copy-default"
    },
    "listing.diagnose": {
      "bundle": "1.0.0",
      "skills": ["size-guide@3.0.1", "care@1.1.0"],
      "modelRoute": "diagnose-default"
    }
  },
  "bridge": {
    "service": "businessAgent",
    "method": "run",
    "mode": "stream",
    "internalEndpoint": "/internal/agent/run",
    "healthEndpoint": "/internal/health",
    "principal": "business-api",
    "note": "见 bridge/README.md；Host 侧 mjs 插件已用 DSH 0.2.1-rc.2 真实联调通过（t18，见 docs/验收记录-M2-DSH真实联调.md），生产化剩余项见 bridge/README.md §5。"
  },
  "mcp": {
    "policy": "config/mcp-policy.yaml",
    "servers": "config/mcp-servers.yaml",
    "note": "M1 仅占位：两个只读 MCP server 尚未实现（packages/mcp-erp、packages/mcp-knowledge 为空壳）。"
  }
}
