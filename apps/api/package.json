{
  "name": "@dssaas/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify 业务 API：编排 / 写入门 / 模型网关 / 平台适配 / 身份 / 审计",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "seed": "tsx src/seed.ts",
    "audit:verify": "tsx src/scripts/verify-audit.ts",
    "test": "tsx test/run.ts",
    "test:agent": "tsx --test --test-concurrency=1 --test-reporter=spec test/agent.test.ts",
    "smoke:agent": "tsx test/agent-smoke.ts",
    "test:file": "tsx --test",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@dssaas/core": "workspace:*",
    "@dssaas/db": "workspace:*",
    "@dssaas/judge-rules": "workspace:*",
    "@dssaas/registry": "workspace:*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^9.4.0",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.7",
    "otpauth": "^9.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.20.0"
  }
}
