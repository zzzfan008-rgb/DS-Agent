# =============================================================
# 服装电商双平台运营系统 · 环境变量模板
# 用法：cp .env.example .env 后按本机情况修改；.env 已被 .gitignore 忽略。
# 本文件中的值全部是开发默认值，禁止用于生产。
# =============================================================

# ---- Postgres（pgvector）----
POSTGRES_USER=dssaas
POSTGRES_PASSWORD=dssaas_dev_pw
POSTGRES_DB=dssaas
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dssaas:dssaas_dev_pw@localhost:5432/dssaas?schema=public

# ---- Redis（BullMQ）----
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---- MinIO（S3 兼容，素材与视频）----
MINIO_ROOT_USER=dssaas
MINIO_ROOT_PASSWORD=dssaas_dev_pw
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY=dssaas
S3_SECRET_KEY=dssaas_dev_pw
S3_BUCKET_ASSETS=dssaas-assets

# ---- Caddy（唯一对外入口，反代 web:3000 / api:3001）----
CADDY_HTTP_PORT=80
# Caddy 反代目标：默认指向宿主机上的 dev 进程；若 api/web 也进 compose，改成 api:3001 / web:3000
API_UPSTREAM=host.docker.internal:3001
WEB_UPSTREAM=host.docker.internal:3000

# ---- 业务镜像（compose --profile app 使用；M1 阶段镜像尚未构建）----
DSSAAS_API_IMAGE=dssaas/api:dev
DSSAAS_WORKER_IMAGE=dssaas/worker:dev

# ---- DSH（agent 内核；持久卷 dsh-data 挂载点）----
DSH_HOME=/var/lib/dsh
DSH_HOST_URL=http://host.docker.internal:8787
DSH_REMOTE_PATH=/dssaas/agent

# ---- 业务进程 ----
WEB_PORT=3000
API_PORT=3001
NODE_ENV=development
TZ=Asia/Shanghai
